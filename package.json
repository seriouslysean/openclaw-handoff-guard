{
  "name": "@seriouslysean/openclaw-handoff-guard",
  "version": "0.1.0",
  "private": true,
  "description": "An OpenClaw plugin that checks text an agent sends to another agent for secrets and personal data, by group, with a mode per group.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agents",
    "pii",
    "privacy"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 'test/*.test.ts'"
  },
  "dependencies": {
    "@arcjet/redact": "1.14.1",
    "@secretlint/node": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "ibantools": "4.5.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openclaw": "2026.10.5",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    }
  },
  "files": [
    "dist/",
    "src/",
    "config/",
    "openclaw.plugin.json"
  ]
}
